// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Text {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
}

model FormattedLetter {
  id        String    @id @default(uuid())
  letter    String
  styleType StyleType
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// A distinct Swedish sound. Its color/style applies to every Latin spelling of that sound.
model Phoneme {
  id        String            @id @default(uuid())
  symbol    String            @unique
  styleType StyleType
  color     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  spellings PhonemeSpelling[]
}

// A Latin-letter rendering of a phoneme, e.g. the phoneme /k/ can be spelled "k".
model PhonemeSpelling {
  id        String   @id @default(uuid())
  phonemeId String
  phoneme   Phoneme  @relation(fields: [phonemeId], references: [id])
  spelling  String
  createdAt DateTime @default(now())
}

enum StyleType {
  unstyled
  underlined
  colored
}
