// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Text {
  id          String       @id @default(uuid())
  title       String
  content     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  textLetters TextLetter[]
}

model FormattedLetter {
  id          String       @id @default(uuid())
  letter      String
  styleType   StyleType     @default(unstyled)
  color       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  textLetters TextLetter[]
}

model TextLetter {
  id                String          @id @default(uuid())
  textId            String
  formattedLetterId String
  position          Int
  createdAt         DateTime        @default(now())
  text              Text            @relation(fields: [textId], references: [id], onDelete: Cascade)
  formattedLetter   FormattedLetter @relation(fields: [formattedLetterId], references: [id], onDelete: Restrict)

  @@unique([textId, position])
  @@index([formattedLetterId])
}

enum StyleType {
  unstyled
  underlined
  colored
}
